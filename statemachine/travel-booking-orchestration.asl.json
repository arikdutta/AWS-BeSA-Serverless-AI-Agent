{
  "Comment": "Multi-Agent Travel Booking Orchestration - Pure Task Token Pattern (No SQS)",
  "StartAt": "PlannerExtract",
  "States": {
    "PlannerExtract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${OrchPlannerFunctionArn}",
        "Payload": {
          "action": "extract",
          "bookingID.$": "$.bookingID",
          "userId.$": "$.userId",
          "origin.$": "$.origin",
          "destination.$": "$.destination",
          "travel_dates.$": "$.travel_dates",
          "travelers.$": "$.travelers",
          "budget.$": "$.budget",
          "airline_preference.$": "$.airline_preference",
          "interests.$": "$.interests"
        }
      },
      "ResultPath": "$.plannerExtractResult",
      "ResultSelector": {
        "statusCode.$": "$.Payload.statusCode",
        "extractedData.$": "$.Payload.extractedData",
        "confidence.$": "$.Payload.confidence",
        "ready_for_coordination.$": "$.Payload.ready_for_coordination"
      },
      "Next": "ParallelWeatherAndFlight",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError",
          "ResultPath": "$.error"
        }
      ]
    },

    "ParallelWeatherAndFlight": {
      "Type": "Parallel",
      "Comment": "Execute weather analysis and flight search in parallel",
      "Branches": [
        {
          "StartAt": "WeatherGet",
          "States": {
            "WeatherGet": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${OrchWeatherFunctionArn}",
                "Payload": {
                  "action": "analyze",
                  "bookingID.$": "$.bookingID",
                  "origin.$": "$.origin",
                  "destination.$": "$.destination",
                  "travel_dates.$": "$.travel_dates",
                  "travelers.$": "$.travelers"
                }
              },
              "ResultSelector": {
                "statusCode.$": "$.Payload.statusCode",
                "weather_analysis.$": "$.Payload.weather_analysis",
                "risk_level.$": "$.Payload.risk_level",
                "conditions.$": "$.Payload.conditions",
                "recommendation.$": "$.Payload.recommendation"
              },
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2.0
                }
              ]
            }
          }
        },
        {
          "StartAt": "FlightSearch",
          "States": {
            "FlightSearch": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${OrchFlightFunctionArn}",
                "Payload": {
                  "action": "search",
                  "bookingID.$": "$.bookingID",
                  "origin.$": "$.origin",
                  "destination.$": "$.destination",
                  "travel_dates.$": "$.travel_dates",
                  "travelers.$": "$.travelers",
                  "budget.$": "$.budget",
                  "airline_preference.$": "$.airline_preference"
                }
              },
              "ResultSelector": {
                "statusCode.$": "$.Payload.statusCode",
                "flights_found.$": "$.Payload.flights_found",
                "flight_options.$": "$.Payload.flight_options",
                "best_option.$": "$.Payload.best_option",
                "within_budget.$": "$.Payload.within_budget"
              },
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2.0
                }
              ]
            }
          }
        }
      ],
      "ResultPath": "$.parallelResults",
      "Next": "PlannerAnalyzeAndBook",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError",
          "ResultPath": "$.error"
        }
      ]
    },

    "PlannerAnalyzeAndBook": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${OrchPlannerFunctionArn}",
        "Payload": {
          "action": "analyze_and_decide",
          "bookingID.$": "$.bookingID",
          "userId.$": "$.userId",
          "origin.$": "$.origin",
          "destination.$": "$.destination",
          "travel_dates.$": "$.travel_dates",
          "travelers.$": "$.travelers",
          "budget.$": "$.budget",
          "airline_preference.$": "$.airline_preference",
          "interests.$": "$.interests",
          "weather_data.$": "$.parallelResults[0]",
          "flight_data.$": "$.parallelResults[1]"
        }
      },
      "ResultPath": "$.plannerResult",
      "ResultSelector": {
        "statusCode.$": "$.Payload.statusCode",
        "decision.$": "$.Payload.decision",
        "decision_reason.$": "$.Payload.decision_reason",
        "booking_status.$": "$.Payload.booking_status",
        "booking_confirmation.$": "$.Payload.booking_confirmation",
        "message.$": "$.Payload.message"
      },
      "Next": "CheckPlannerDecision",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError",
          "ResultPath": "$.error"
        }
      ]
    },

    "CheckPlannerDecision": {
      "Type": "Choice",
      "Comment": "Check if planner booked automatically or needs human review",
      "Choices": [
        {
          "Variable": "$.plannerResult.decision",
          "StringEquals": "booked",
          "Next": "BookingSuccess"
        },
        {
          "Variable": "$.plannerResult.decision",
          "StringEquals": "needs_human_review",
          "Next": "WaitForHuman"
        }
      ],
      "Default": "HandleError"
    },

    "BookingSuccess": {
      "Type": "Pass",
      "Parameters": {
        "statusCode": 200,
        "booking_status": "completed",
        "message": "Booking completed successfully",
        "booking_confirmation.$": "$.plannerResult.booking_confirmation"
      },
      "End": true
    },

    "WaitForHuman": {
      "Type": "Task",
      "Resource": "${HumanReviewActivityArn}",
      "Comment": "Wait for human review via Step Functions Activity",
      "ResultPath": "$.humanDecision",
      "TimeoutSeconds": 3600,
      "Next": "ProcessHumanDecision",
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "Next": "HumanReviewTimeout",
          "ResultPath": "$.timeoutError"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError",
          "ResultPath": "$.error"
        }
      ]
    },

    "ProcessHumanDecision": {
      "Type": "Choice",
      "Comment": "Process the human decision: approved or rejected",
      "Choices": [
        {
          "Variable": "$.humanDecision.decision",
          "StringEquals": "approved",
          "Next": "PlannerFinalizeBooking"
        },
        {
          "Variable": "$.humanDecision.decision",
          "StringEquals": "rejected",
          "Next": "BookingRejected"
        }
      ],
      "Default": "BookingRejected"
    },

    "PlannerFinalizeBooking": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${OrchPlannerFunctionArn}",
        "Payload": {
          "action": "finalize_booking",
          "bookingID.$": "$.bookingID",
          "userId.$": "$.userId",
          "origin.$": "$.origin",
          "destination.$": "$.destination",
          "travel_dates.$": "$.travel_dates",
          "travelers.$": "$.travelers",
          "budget.$": "$.budget",
          "airline_preference.$": "$.airline_preference",
          "interests.$": "$.interests",
          "weather_data.$": "$.parallelResults[0]",
          "flight_data.$": "$.parallelResults[1]",
          "human_approval.$": "$.humanDecision"
        }
      },
      "ResultPath": "$.finalBookingResult",
      "ResultSelector": {
        "statusCode.$": "$.Payload.statusCode",
        "booking_status.$": "$.Payload.booking_status",
        "booking_confirmation.$": "$.Payload.booking_confirmation",
        "message.$": "$.Payload.message"
      },
      "Next": "BookingSuccess",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError",
          "ResultPath": "$.error"
        }
      ]
    },

    "BookingRejected": {
      "Type": "Pass",
      "Parameters": {
        "statusCode": 200,
        "booking_status": "rejected",
        "message": "Booking was rejected",
        "rejection_reason.$": "$.humanDecision.reason"
      },
      "End": true
    },

    "HumanReviewTimeout": {
      "Type": "Pass",
      "Result": {
        "statusCode": 408,
        "booking_status": "timeout",
        "message": "Human review timed out after 1 hour",
        "timeout_reason": "No human decision received within the allowed timeframe"
      },
      "End": true
    },

    "HandleError": {
      "Type": "Pass",
      "Result": {
        "statusCode": 500,
        "booking_status": "error",
        "message": "An error occurred during the booking process",
        "error_details": "Check execution logs for more information"
      },
      "End": true
    }
  }
}
